{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "jsx": "react-jsx",
    "noEmit": true,
    "experimentalDecorators": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strict": true,
    "sourceMap": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
